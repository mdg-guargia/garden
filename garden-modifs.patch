@@ -0,0 +1,33 @@
+import Link from "next/link";
+import { HomeLayout } from "@/components/HomeLayout";
+import { projects } from "@/data/working-on";
+import { profile } from "@/data/profile";
+
+export const metadata = { title: `What I'm building — ${profile.name}` };
+
+// Same shell as the homepage (logo, name, photo, no nav/footer) — only the
+// list changes: here it enumerates projects instead of sections.
+export default function WorkingOnPage() {
+  return (
+    <HomeLayout tagline="what i'm building:">
+      {projects.map((p) => (
+        <p key={p.id}>
+          {p.href ? (
+            p.href.startsWith("http") ? (
+              <a href={p.href} className="underline-link">
+                {p.title}
+              </a>
+            ) : (
+              <Link href={p.href} className="underline-link">
+                {p.title}
+              </Link>
+            )
+          ) : (
+            p.title
+          )}
+          {p.note && <> — {p.note}</>}
+        </p>
+      ))}
+    </HomeLayout>
+  );
+}
